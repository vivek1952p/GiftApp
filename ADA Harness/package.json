{
  "name": "ada-harness",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready ADA accessibility harness (Playwright + axe-core + Copilot Agent Mode) for the React app.",
  "scripts": {
    "scan": "npx tsx scripts/analyze.ts",
    "summary": "npx tsx scripts/generate-summary.ts",
    "uia": "npx tsx scripts/uia-scan.ts",
    "uia:rules": "npx tsx scripts/uia-rule-engine.ts",
    "merge": "npx tsx scripts/merge-report.ts",
    "compare": "npx tsx scripts/compare.ts",
    "dashboard": "npx tsx scripts/dashboard.ts",
    "ada": "npm run scan && npm run dashboard"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "axe-core": "^4.12.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
